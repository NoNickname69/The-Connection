# Only needed for a deployed (production) build. Set this in your Vercel
# project's Environment Variables to your deployed server's URL, e.g.
# VITE_SERVER_URL=https://the-connection-server.onrender.com
#
# Leave it unset for local development -- the client will automatically
# connect to whatever host served the page, on port 3001.
VITE_SERVER_URL=
